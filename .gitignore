# Unreal build output and caches (regenerated on build)
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
Plugins/**/Binaries/
Plugins/**/Intermediate/

# IDE / generated project files (regenerate via "Generate Visual Studio project files")
.vs/
.vscode/
.idea/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.xcworkspace
*.xcodeproj
compile_commands.json

# OS / misc
.DS_Store
Thumbs.db
__pycache__/

# Content/Data holds plain JSON read at runtime. If the editor offers to import it, decline;
# any assets it creates here are strays.
Content/Data/*.uasset

# Per-user editor folders (personal collections / scratch assets)
Content/Developers/
Content/Collections/
